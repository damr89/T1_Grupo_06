<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#d19815"
    android:orientation="vertical">

    <!-- Encabezado fijo: Cerrar sesión + Logo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btnCerrarSesion"
            style="@style/Widget.Productos.BotonTexto"
            android:text="Cerrar sesión" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/logoUPN"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:adjustViewBounds="true"
            android:contentDescription="Logo UPN"
            android:src="@drawable/logo" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollProductos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <!-- ==================== Tarjeta 1: Formulario ==================== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#adadac"
                app:cardCornerRadius="30dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="25dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="GESTIÓN DE PRODUCTOS"
                        android:textColor="#000000"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp"
                        android:gravity="center"
                        android:text="Registra y consulta los productos del inventario"
                        android:textColor="#333333"
                        android:textSize="13sp" />

                    <!-- Código -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCodigo"
                        style="@style/Widget.Productos.Campo"
                        android:hint="Código del producto">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCodigoProducto"
                            style="@style/Widget.Productos.CampoTexto"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:maxLength="20" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Nombre -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNombre"
                        style="@style/Widget.Productos.Campo"
                        android:hint="Nombre del producto">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNombreProducto"
                            style="@style/Widget.Productos.CampoTexto"
                            android:inputType="textCapSentences"
                            android:maxLength="60" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Descripción -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDescripcion"
                        style="@style/Widget.Productos.Campo"
                        android:hint="Descripción del producto">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDescripcionProducto"
                            style="@style/Widget.Productos.CampoTexto"
                            android:inputType="textCapSentences"
                            android:maxLength="120" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Precio -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPrecio"
                        style="@style/Widget.Productos.Campo"
                        android:hint="Precio del producto"
                        app:prefixText="S/ "
                        app:prefixTextColor="#000000">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPrecioProducto"
                            style="@style/Widget.Productos.CampoTexto"
                            android:inputType="numberDecimal"
                            android:maxLength="10" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Marca -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilMarca"
                        style="@style/Widget.Productos.Campo"
                        android:layout_marginBottom="20dp"
                        android:hint="Marca del producto">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMarcaProducto"
                            style="@style/Widget.Productos.CampoTexto"
                            android:imeOptions="actionDone"
                            android:inputType="textCapWords"
                            android:maxLength="40" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Botones CRUD -->
                    <Button
                        android:id="@+id/btnRegistrarProducto"
                        style="@style/Widget.Productos.Boton"
                        android:backgroundTint="#F29325"
                        android:text="Registrar Producto" />

                    <Button
                        android:id="@+id/btnBuscarProducto"
                        style="@style/Widget.Productos.Boton"
                        android:backgroundTint="#4A3B7D"
                        android:text="Buscar Producto" />

                    <Button
                        android:id="@+id/btnModificarProducto"
                        style="@style/Widget.Productos.Boton"
                        android:backgroundTint="#4A3B7D"
                        android:text="Modificar Producto" />

                    <Button
                        android:id="@+id/btnEliminarProducto"
                        style="@style/Widget.Productos.Boton"
                        android:layout_marginBottom="0dp"
                        android:backgroundTint="#B71C46"
                        android:text="Eliminar Producto" />

                    <Button
                        android:id="@+id/btnLimpiarFormulario"
                        style="@style/Widget.Productos.BotonTexto"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="5dp"
                        android:text="Limpiar campos" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ==================== Tarjeta 2: Productos registrados ==================== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#adadac"
                app:cardCornerRadius="30dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvTotalProductos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Productos registrados (3)" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:text="Toca un producto para verlo en el formulario."
                        android:textColor="#333333"
                        android:textSize="13sp" />

                    <!-- Filtro de la lista -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFiltro"
                        style="@style/Widget.Productos.Campo"
                        android:hint="Filtrar por código, nombre o marca"
                        app:endIconMode="clear_text"
                        app:endIconTint="#555555">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFiltroProductos"
                            style="@style/Widget.Productos.CampoTexto"
                            android:imeOptions="actionSearch"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Mensaje cuando no hay productos -->
                    <TextView
                        android:id="@+id/tvListaVacia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="Aún no hay productos registrados."
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvProductos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_producto" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
